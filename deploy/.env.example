# Copy to .env on the server. Leave a provider key empty to disable that provider.
AEGIS_ADMIN_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts provider keys saved from the dashboard (Providers page).
# Generate once with `openssl rand -hex 32` and do not change it afterwards.
AEGIS_SECRET_KEY=

# Optional: webhook URL (Slack, Discord, or any JSON POST receiver) for alerts.
AEGIS_ALERT_WEBHOOK=
